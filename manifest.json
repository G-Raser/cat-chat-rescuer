{
  "manifest_version": 3,
  "name": "CatChat Rescuer",
  "version": "0.4.3",
  "description": "Locally capture and incrementally archive long ChatGPT conversations as Markdown and JSON.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "Open CatChat Rescuer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "api-experiment.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
